# 接口与 Mock 开关
# VITE_USE_MOCK=true 时前端使用本地 Mock 数据；
# 改为 false 后走 VITE_API_BASE_URL（默认 http://127.0.0.1:8000）真实后端
VITE_USE_MOCK=true
# 真实后端基地址（Mock 模式下不会被使用）
VITE_API_BASE_URL=http://127.0.0.1:8000

# AI 营养师（VITE_USE_MOCK=false 时生效）
# 密钥不要写在这里：请写到 frontend/.env.local（已被 .gitignore 的 *.local 忽略）
VITE_AI_BASE_URL=https://api.deepseek.com
VITE_AI_MODEL=deepseek-flash
VITE_AI_API_KEY=
