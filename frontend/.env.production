# 接口与 Mock 开关
# 生产默认仍为 Mock 演示；对接 FastAPI 部署时改为 false 并按需修改基地址
VITE_USE_MOCK=true
# 真实后端基地址（VITE_USE_MOCK=false 时生效）
VITE_API_BASE_URL=http://127.0.0.1:8000
# 构建保护放行项：当前演示版允许在 VITE_USE_MOCK=true 时执行生产构建。
# 正式部署请将上面的 VITE_USE_MOCK 改为 false，并删除下面这一行；
# 两者同时为 mock 且未显式放行时，vite 构建会直接报错中止。
VITE_ALLOW_MOCK_BUILD=true
